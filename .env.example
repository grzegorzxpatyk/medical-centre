# Used by docker-compose (dev and prod)
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=medical_centre

# Payload CMS
DATABASE_URL=postgresql://payload:payload@localhost:5432/medical_centre
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Frontend -> CMS. In production these are the public https:// hostnames;
# NEXT_PUBLIC_CMS_URL is inlined into the web bundle at build time, so changing
# it means rebuilding the web image, not just restarting it.
CMS_URL=http://localhost:3001
NEXT_PUBLIC_CMS_URL=http://localhost:3001

# CMS CORS allowlist
FRONTEND_URL=http://localhost:3000

# Let search engines index the site. Leave false for preview deploys.
SITE_INDEXABLE=false

# Set to 1 to make the seed overwrite existing content and drop anything
# not listed in apps/cms/src/seed.ts. Leave unset for normal deploys.
SEED_FORCE=0

# --- Production only (docker-compose.prod.yml) ------------------------------

# Hostnames Caddy serves (www.SITE_DOMAIN redirects to the apex). DNS lives in
# Cloudflare as proxied AAAA records; the origin certificate goes in deploy/certs/.
SITE_DOMAIN=gabinetzielonki.pl
CMS_DOMAIN=cms.gabinetzielonki.pl

# Where to pull the app images from. Leave unset to build locally instead.
REGISTRY=ghcr.io/grzegorzxpatyk/medical-centre
IMAGE_TAG=latest
