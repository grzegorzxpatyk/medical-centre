# Reverse proxy for the production stack.
#
# Caddy terminates TLS and obtains/renews Let's Encrypt certificates on its
# own, which is why no app container publishes a port on the host any more —
# cms and web are reachable only over the compose network.
#
# Both hostnames must already resolve to this server's public IP *before* the
# stack starts. ACME uses an HTTP-01 challenge on port 80; if DNS is not in
# place yet Caddy retries with a growing backoff and the site serves a TLS
# error in the meantime.
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

{$CMS_DOMAIN} {
	encode zstd gzip
	reverse_proxy cms:3001
}
